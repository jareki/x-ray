# Настройки foreign VPS.
# Скопируйте в settings.env и заполните:  cp settings.env.example settings.env
# settings.env не хранится в git, поэтому git pull его не трогает.
# Файл подключается как bash-скрипт: значения в кавычках, без пробелов вокруг «=».

# Домен сервера (A-запись должна указывать на IP этого сервера)
DOMAIN="your-domain.com"

# E-mail для аккаунта Let's Encrypt
EMAIL="your@email.com"

# Внутренние порты Caddy (слушает только 127.0.0.1). Менять обычно не нужно
#CADDY_HTTPS_PORT="8443"
#CADDY_HTTP_PORT="8080"
