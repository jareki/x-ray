{
    # e-mail для ACME-аккаунта (Let's Encrypt, при сбое — ZeroSSL)
    email {{EMAIL}}
    # :443 занят Xray, поэтому авто-редиректы Caddy (на https://домен:8443) не нужны —
    # редирект с :80 описан явно ниже. Выпуск/продление сертификата это не отключает.
    auto_https disable_redirects
}

# HTTPS — для REALITY dest. Сертификат Caddy выпускает и продлевает сам (HTTP-01 через :80)
{{DOMAIN}}:{{CADDY_HTTPS_PORT}} {
    bind 127.0.0.1
    root * {{STUB_DIR}}
    file_server
    encode gzip zstd

    header {
        -Server
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        -X-Powered-By
    }

    log {
        output file {{LOG_DIR_CADDY}}/stub.log {
            roll_size 10mb
            roll_keep 5
        }
        format json
    }
}

# Plain HTTP — для VLESS fallbacks (трафик уже расшифрован Xray).
# Схема http:// обязательна: иначе Caddy поднимет на IP-адресе HTTPS с внутренним сертификатом
http://127.0.0.1:{{CADDY_HTTP_PORT}} {
    root * {{STUB_DIR}}
    file_server
    encode gzip zstd

    header {
        -Server
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        -X-Powered-By
    }

    log {
        output file {{LOG_DIR_CADDY}}/stub.log {
            roll_size 10mb
            roll_keep 5
        }
        format json
    }
}

# HTTP :80 — редирект на HTTPS (маскировка под обычный сайт).
# Здесь же Caddy автоматически отвечает на ACME HTTP-01 challenge
http://{{DOMAIN}} {
    redir https://{{DOMAIN}}{uri} permanent
}
